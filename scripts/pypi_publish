#!/bin/bash

########################################################################
# Publish the packages in dist/ (see scripts/build_packages) to PyPI.
# Authenticate by setting UV_PUBLISH_TOKEN to a PyPI API token (or
# use trusted publishing). See `uv publish --help` for other options.
########################################################################

set -euo pipefail

# Determine the script's directory (even if it's a symbolic link)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
SCRIPTS_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SRC_DIR="$(cd -P "$(dirname "$SCRIPTS_DIR")" && pwd)"

# Usage documentation
function usage() {
    echo "Usage: $(basename "$0") [--test] [-y]"
    echo ""
    echo "Publish Raster Vision plugins and top-level package to PyPI or TestPyPI."
    echo ""
    echo "Options:"
    echo "  -y        Automatically answer 'yes' to prompts."
    echo "  --test    Publish to TestPyPI instead of PyPI."
}

function publish_all() {
    if [ "$publish_to_test" = true ]; then
        echo "Publishing to TestPyPI ... "
        uv publish \
            --publish-url https://test.pypi.org/legacy/ \
            --check-url https://test.pypi.org/simple/ \
            "$SRC_DIR"/dist/*
    else
        echo "Publishing to PyPI ... "
        uv publish --check-url https://pypi.org/simple/ "$SRC_DIR"/dist/*
    fi
    echo "Done."
}

# Check for command-line arguments
if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
    usage
    exit
fi

if ! compgen -G "$SRC_DIR/dist/*" >/dev/null; then
    echo "No packages found in $SRC_DIR/dist/. Run scripts/build_packages first."
    exit 1
fi

# Check if the --test flag is passed
publish_to_test=false
if [[ ${1:-} == "--test" ]]; then
    publish_to_test=true
    # Remove the --test flag from the arguments
    shift
fi

# If testing: publish and exit
if [ "$publish_to_test" = true ]; then
    publish_all
    exit
fi

# If actually publishing: prompt for confirmation
if [[ ${1:-} == "-y" ]]; then
    response="y"
else
    read -r -p "Actually publish to PyPI? (y/N): " response
fi

case "$response" in
[yY][eE][sS] | [yY])
    publish_all
    ;;
*)
    echo "Aborting."
    ;;
esac
