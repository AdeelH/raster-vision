#!/bin/bash

########################################################################
# Build sdists and wheels for all Raster Vision packages into dist/.
########################################################################

set -euo pipefail

# Determine the script's directory (even if it's a symbolic link)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
SCRIPTS_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SRC_DIR="$(cd -P "$(dirname "$SCRIPTS_DIR")" && pwd)"

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
    echo "Usage: $(basename "$0")"
    echo ""
    echo "Build Raster Vision plugins and top-level package into dist/."
    exit
fi

cd "$SRC_DIR"
rm -rf dist/
uv build --all-packages --out-dir dist/
