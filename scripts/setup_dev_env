#!/bin/bash

########################################################################
# Create a virtual environment (.venv) with all Raster Vision packages
# installed in editable mode, along with all locked dependencies.
# Requires uv: https://docs.astral.sh/uv/getting-started/installation/
########################################################################

set -euo pipefail

# Determine the script's directory (even if it's a symbolic link)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
SCRIPTS_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SRC_DIR="$(cd -P "$(dirname "$SCRIPTS_DIR")" && pwd)"

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
    echo "Usage: $(basename "$0") [<extra uv sync args>]"
    echo ""
    echo "Run 'uv sync' for all packages, extras, and dependency groups."
    exit
fi

cd "$SRC_DIR"
uv sync --all-packages --all-extras --all-groups "$@"
