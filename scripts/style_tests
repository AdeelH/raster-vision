#!/bin/bash

set -e

if [[ -n "${RASTER_VISION_DEBUG}" ]]; then
    set -x
fi

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ] ; do SOURCE="$(readlink "$SOURCE")"; done
SCRIPTS_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
SRC_DIR="$( cd -P "$( dirname "$SCRIPTS_DIR" )" && pwd )"

function usage() {
    echo -n \
"Usage: $(basename "$0")
Lint (ruff), check formatting (ruff format), and type check (pyright) the code.
"
}


if [ "${1:-}" = "--help" ]; then
    usage
else
    cd "$SRC_DIR"

    echo "Linting with ruff..."
    if ! ruff check .; then
        echo "Unsorted imports (I001) can be fixed with ./scripts/format_code."
        exit 1
    fi

    echo "Checking formatting with ruff..."
    if ! ruff format --check .; then
        echo "Code has not been formatted. Need to run ./scripts/format_code."
        exit 1
    fi

    echo "Type checking with pyright..."
    pyright
fi
